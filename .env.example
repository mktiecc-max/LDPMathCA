# Sao chép thành .env.local khi chạy `vercel dev`, và khai báo y hệt trên
# Vercel Dashboard > Project > Settings > Environment Variables

# BẮT BUỘC: mật khẩu đăng nhập trang quản trị /admin
ADMIN_PASSWORD=dat-mat-khau-that-manh

# BẮT BUỘC (để CMS lưu được nội dung): Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role_key...

# TÙY CHỌN: URL Web App của Google Apps Script.
# Có thể bỏ trống ở đây và nhập trực tiếp trong /admin > Cài đặt.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# TÙY CHỌN: chuỗi bí mật để ký token đăng nhập.
# Bỏ trống thì hệ thống dùng ADMIN_PASSWORD để ký.
# Lưu ý: đổi ADMIN_PASSWORD sẽ làm mọi phiên đăng nhập cũ hết hiệu lực.
ADMIN_SECRET=
